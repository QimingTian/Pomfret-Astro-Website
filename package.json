    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.184.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.184.0",
    "autoprefixer": "^10.4.0",
