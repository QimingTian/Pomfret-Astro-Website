[Unit]
Description=Pomfret Astro ASI camera service
After=network.target

[Service]
Type=simple
User=pomfretastro
WorkingDirectory=/home/pomfretastro/Pomfret-School-VISTA-Balcony-Project
# Use venv Python (run scripts/setup-camera-venv.sh first)
ExecStart=/home/pomfretastro/Pomfret-School-VISTA-Balcony-Project/.venv-camera/bin/python3 /home/pomfretastro/Pomfret-School-VISTA-Balcony-Project/camera_service.py
Restart=on-failure
RestartSec=5

# Google Drive sequence uploads
Environment=GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/home/pomfretastro/.config/pomfret-drive-sa.json
Environment=GOOGLE_DRIVE_SEQUENCE_FOLDER_ID=1aRm-ly3N8CxEUKwUzHQzvumySJrNKXDV

[Install]
WantedBy=multi-user.target
